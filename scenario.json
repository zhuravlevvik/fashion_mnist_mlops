{
    "base_url": "http://127.0.0.1:8000",
    "scenarios": [
        {
            "name": "health",
            "method": "GET",
            "path": "/health",
            "expected_status": 200,
            "expected_fields": ["status"]
        },
        {
            "name": "model metadata",
            "method": "GET",
            "path": "/model",
            "expected_status": 200,
            "expected_fields": ["algorithm", "classes", "created_at"]
        },
        {
            "name": "black image prediction",
            "method": "POST",
            "path": "/predict",
            "payload": {"pixels": {"fill": 0, "size": 784}},
            "expected_status": 200,
            "expected_fields": ["class_id", "label", "confidence", "probabilities"]
        }
    ]
}